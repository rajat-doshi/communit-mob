{
  "name": "community",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "analyse": "npx react-native-bundle-visualizer",
    "android:dev": "ENVFILE=.env.development react-native run-android --variant=devDebug",
    "android:staging": "ENVFILE=.env.staging react-native run-android --variant=stagingDebug",
    "android:prod": "ENVFILE=.env.production react-native run-android --variant=prodRelease",
    "apk:dev": "cd android && ./gradlew assembleDevRelease",
    "apk:staging": "cd android && ./gradlew assembleStagingRelease",
    "apk:prod": "cd android && ./gradlew assembleProdRelease",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true react-native run-ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true react-native run-android",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/new-app-screen": "0.86.0",
    "@storybook/addon-ondevice-actions": "^10.4.7",
    "@storybook/addon-ondevice-controls": "^10.4.7",
    "@storybook/react-native": "^10.4.7",
    "@storybook/react-native-ui-lite": "^10.4.7",
    "@tamagui/babel-plugin": "^2.4.0",
    "@tamagui/config": "^2.4.0",
    "babel-loader": "^8.4.1",
    "cross-env": "^10.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.10.0",
    "storybook": "^10.4.6",
    "tamagui": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-native-web-vite": "^10.4.6",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^8.19.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-storybook": "^10.4.6",
    "jest": "^29.6.3",
    "playwright": "^1.61.1",
    "prettier": "2.8.8",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "storybook": "^10.4.6",
    "typescript": "^5.8.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
